      <title>Financial Giants Pose Hidden Societal Threats</title>
      <link>https://www.bloomberg.com/opinion/articles/2026-11-09/financial-giants-pose-hidden-societal-threats</link>
      <guid isPermaLink="false">cf25e8dac0d442d5394f0b37</guid>
