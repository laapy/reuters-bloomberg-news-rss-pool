      <title>Where Do You Hide From an AI Bubble?</title>
      <link>https://www.bloomberg.com/news/videos/2026-11-02/where-do-you-hide-from-an-ai-bubble-video</link>
      <guid isPermaLink="false">5699a9f9dcacd0efcaf58143</guid>
