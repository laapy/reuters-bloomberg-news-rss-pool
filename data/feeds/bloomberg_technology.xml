      <title>AI Whistleblowers, Google, OpenAI, Meta to Face New York City Council</title>
      <link>https://www.bloomberg.com/news/articles/2026-10-04/ai-whistleblowers-google-openai-meta-to-face-new-york-city-council</link>
      <guid isPermaLink="false">91da6531b7f450a72cb022e3</guid>
